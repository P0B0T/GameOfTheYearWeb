@using GameOfTheYearWeb.DataBase.Entity

@{
    ViewData["Title"] = "Game";
}

@model IEnumerable<Record>

<div id="gameBoard"></div>

@if (ViewBag.Mode == "two")
{
    <div id="divScore">
        <label>Player1 score:</label>
        <input style="padding-left: 1em" type="number" readonly value="0" />
    </div>

    <div id="divScore2">
        <label>Player2 score:</label>
        <input style="padding-left: 1em" type="number" readonly value="0" />
    </div>
}
else
{
    <div id="divScore">
        <label>Player score:</label>
        <input style="padding-left: 1em" type="number" readonly value="0" />
        <div class="divMargin">
            <label>Top players:</label>
            @foreach (var item in Model)
            {
                <div>
                    <label>@item.Name</label>
                    <label>@item.Score</label>
                </div>
            }
        </div>
    </div>
}

<div id="divSpeed">
    <label style="width: 3em">Speed:</label>
    <span id="current"></span>
    <input type="range" min="0.1" max="2" step="0.1" value="1" />
    <div id="divNumbers">
        <label id="min">0.1</label>
        <label id="max">2</label>
    </div>
</div>